    description: "node -e \"\nimport(\'@google/genai\').then(async ({ GoogleGenAI, Type }) => {\n  const apiKey = process.env.resumeAnalyzer || process.env.GEMINI_API_KEY;\n  const ai = new GoogleGenAI({ apiKey, httpOptions: { headers: { \'User-Agent\': \'aistudio-build\' } } });\n  \n  const models = [\'gemini-3.8-flash\', \'gemini-3.5-flash\', \'gemini-flash-latest\'];\n  \n  async function callWithRetry() {\n    for (const model of models) {\n      for (let attempt = 1; attempt <= 2; attempt++) {\n        try {\n          console.log(\'Trying model:\', model, \'attempt:\', attempt);\n          const res = await ai.models.generateContent({\n            model,\n            contents: \'Resume: Alex Chen, React, TypeScript, Node.js. Job: Junior Full-Stack Developer with React and Node.js. Return valid JSON only with matchScore (integer 0-100), matchedSkills (array of {skill, category, context}), missingSkills (array of {skill, priority, reason}), resumeEvidence (array of {claim, evidence, alignment}), recommendations (array of strings), learningRoadmap (array of {milestone, timeframe, actionItems, resourceSuggestion}), interviewQuestions (array of {question, topic, expectedFocus}).\',\n            config: {\n              responseMimeType: \'application/json\'\n            }\n          });\n          const parsed = JSON.parse(res.text);\n          console.log(\'SUCCESS! matchScore:\', parsed.matchScore);\n          console.log(\'Matched skills:\', parsed.matchedSkills);\n          return parsed;\n        } catch (e) {\n          console.log(\'Model\', model, \'attempt\', attempt, \'failed:\', e.message?.slice(0, 50));\n          await new Promise(r => setTimeout(r, 1200));\n        }\n      }\n    }\n  }\n  \n  await callWithRetry();\n});\n\""
    title: "Test fallback models and retry logic"
    moved_to_background_at {
      seconds: 1792432852
      nanos: 277276874
    }
  }
}
