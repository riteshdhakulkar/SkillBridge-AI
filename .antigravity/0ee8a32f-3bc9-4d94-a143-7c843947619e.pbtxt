        target_content: "interface FooterProps {\n  onOpenAnalyze: () => void;\n  onOpenDashboard: () => void;\n  onNavigateHome: () => void;\n}\n\nexport const Footer: React.FC<FooterProps> = ({\n  onOpenAnalyze,\n  onOpenDashboard,\n  onNavigateHome,\n}) => {\n  return (\n    <footer className=\"border-t border-slate-200 bg-white\">\n      <div className=\"mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8\">\n        <div className=\"flex flex-col md:flex-row items-center justify-between gap-6\">\n          {/* Logo & Description */}\n          <div className=\"flex flex-col items-center md:items-start text-center md:text-left space-y-2\">\n            <button\n              onClick={onNavigateHome}\n              className=\"flex items-center gap-2 text-left cursor-pointer focus:outline-none\"\n            >\n              <div className=\"flex h-7 w-7 items-center justify-center rounded-lg bg-indigo-600 text-white\">\n                <Sparkles className=\"h-4 w-4\" />\n              </div>\n              <span className=\"text-base font-bold text-slate-900\">\n                SkillBridge <span className=\"text-indigo-600\">AI</span>\n              </span>\n            </button>\n            <p className=\"text-xs text-slate-500 max-w-sm\">\n              Empowering students to analyze resumes, identify in-demand skill gaps, and match with ideal tech careers.\n            </p>\n          </div>\n\n          {/* Quick Links */}\n          <nav className=\"flex flex-wrap items-center justify-center gap-6 text-xs font-medium text-slate-600\">\n            <button\n              onClick={onNavigateHome}\n              className=\"hover:text-indigo-600 transition-colors cursor-pointer\"\n            >\n              Home\n            </button>\n            <a\n              href=\"#features\"\n              className=\"hover:text-indigo-600 transition-colors cursor-pointer\"\n            >\n              Features\n            </a>\n            <button\n              onClick={onOpenDashboard}\n              className=\"hover:text-indigo-600 transition-colors cursor-pointer\"\n            >\n              Dashboard\n            </button>\n            <button\n              onClick={onOpenAnalyze}\n              className=\"hover:text-indigo-600 transition-colors cursor-pointer\"\n            >\n              Analyze Resume\n            </button>\n          </nav>\n        </div>\n\n        {/* Bottom line */}\n        <div className=\"mt-8 pt-8 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400\">\n          <p>\302\251 {new Date().getFullYear()} SkillBridge AI. Built for students & early-career professionals.</p>\n          <div className=\"flex items-center gap-1 text-slate-500\">\n            <span>Free and privacy-respecting career tools</span>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};"
        replacement_content: "interface FooterProps {\n  onOpenAnalyze: () => void;\n  onNavigateDashboard: () => void;\n  onNavigateHome: () => void;\n}\n\nexport const Footer: React.FC<FooterProps> = ({\n  onOpenAnalyze,\n  onNavigateDashboard,\n  onNavigateHome,\n}) => {\n  return (\n    <footer className=\"border-t border-slate-200 bg-white\">\n      <div className=\"mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8\">\n        <div className=\"flex flex-col md:flex-row items-center justify-between gap-6\">\n          {/* Logo & Description */}\n          <div className=\"flex flex-col items-center md:items-start text-center md:text-left space-y-2\">\n            <button\n              onClick={onNavigateHome}\n              className=\"flex items-center gap-2 text-left cursor-pointer focus:outline-none\"\n            >\n              <div className=\"flex h-7 w-7 items-center justify-center rounded-lg bg-indigo-600 text-white\">\n                <Sparkles className=\"h-4 w-4\" />\n              </div>\n              <span className=\"text-base font-bold text-slate-900\">\n                SkillBridge <span className=\"text-indigo-600\">AI</span>\n              </span>\n            </button>\n            <p className=\"text-xs text-slate-500 max-w-sm\">\n              Empowering students to analyze resumes, identify in-demand skill gaps, and match with ideal tech careers.\n            </p>\n          </div>\n\n          {/* Quick Links */}\n          <nav className=\"flex flex-wrap items-center justify-center gap-6 text-xs font-medium text-slate-600\">\n            <button\n              onClick={onNavigateHome}\n              className=\"hover:text-indigo-600 transition-colors cursor-pointer\"\n            >\n              Home\n            </button>\n            <button\n              onClick={() => {\n                onNavigateHome();\n                setTimeout(() => {\n                  const el = document.getElementById(\'features\');\n                  if (el) el.scrollIntoView({ behavior: \'smooth\' });\n                }, 100);\n              }}\n              className=\"hover:text-indigo-600 transition-colors cursor-pointer\"\n            >\n              Features\n            </button>\n            <button\n              onClick={onNavigateDashboard}\n              className=\"hover:text-indigo-600 transition-colors cursor-pointer\"\n            >\n              Dashboard\n            </button>\n            <button\n              onClick={onOpenAnalyze}\n              className=\"hover:text-indigo-600 transition-colors cursor-pointer\"\n            >\n              Analyze Resume\n            </button>\n          </nav>\n        </div>\n\n        {/* Bottom line */}\n        <div className=\"mt-8 pt-8 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400\">\n          <p>\302\251 {new Date().getFullYear()} SkillBridge AI. Built for students & early-career professionals.</p>\n          <div className=\"flex items-center gap-1 text-slate-500\">\n            <span>Free and privacy-respecting career tools</span>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n"
