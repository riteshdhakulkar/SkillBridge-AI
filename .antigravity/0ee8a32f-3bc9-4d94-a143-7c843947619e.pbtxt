        recommendations: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING }\n            },\n            learningRoadmap: {\n              type: Type.ARRAY,\n              items: {\n                type: Type.OBJECT,\n                properties: {\n                  milestone: { type: Type.STRING },\n                  timeframe: { type: Type.STRING },\n                  actionItems: { type: Type.ARRAY, items: { type: Type.STRING } },\n                  resourceSuggestion: { type: Type.STRING }\n                },\n                required: [\'milestone\', \'timeframe\', \'actionItems\', \'resourceSuggestion\']\n              }\n            },\n            interviewQuestions: {\n              type: Type.ARRAY,\n              items: {\n                type: Type.OBJECT,\n                properties: {\n                  question: { type: Type.STRING },\n                  topic: { type: Type.STRING },\n                  expectedFocus: { type: Type.STRING }\n                },\n                required: [\'question\', \'topic\', \'expectedFocus\']\n              }\n            }\n          },\n          required: [\n            \'matchScore\',\n            \'matchedSkills\',\n            \'missingSkills\',\n            \'resumeEvidence\',\n            \'recommendations\',\n            \'learningRoadmap\',\n            \'interviewQuestions\'\n          ]\n        }\n      }\n    });\n    console.log(\'SUCCESS matchScore:\', JSON.parse(res.text).matchScore);\n  } catch (err) {\n    console.error(\'error:\', err.message || err);\n  }\n});\n\""
