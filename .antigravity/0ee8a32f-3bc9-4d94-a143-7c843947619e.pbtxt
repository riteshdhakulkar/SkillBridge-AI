      name: "run_command"
      arguments_json: "{\"CommandLine\":\"node -e \\\"\\nimport(\'@google/genai\').then(async ({ GoogleGenAI, Type }) => {\\n  const apiKey = process.env.resumeAnalyzer || process.env.GEMINI_API_KEY;\\n  const ai = new GoogleGenAI({ apiKey, httpOptions: { headers: { \'User-Agent\': \'aistudio-build\' } } });\\n  try {\\n    const res = await ai.models.generateContent({\\n      model: \'gemini-flash-latest\',\\n      contents: \'Resume: Alex Chen, React and TypeScript developer. Job: Junior Full Stack Developer with React and TypeScript.\',\\n      config: {\\n        responseMimeType: \'application/json\',\\n        responseSchema: {\\n          type: Type.OBJECT,\\n          properties: {\\n            matchScore: { type: Type.INTEGER },\\n            matchedSkills: {\\n              type: Type.ARRAY,\\n              items: {\\n                type: Type.OBJECT,\\n                properties: {\\n                  skill: { type: Type.STRING },\\n                  category: { type: Type.STRING },\\n                  context: { type: Type.STRING }\\n                },\\n                required: [\'skill\', \'category\', \'context\']\\n              }\\n            },\\n            missingSkills: {\\n              type: Type.ARRAY,\\n              items: {\\n                type: Type.OBJECT,\\n                properties: {\\n                  skill: { type: Type.STRING },\\n                  priority: { type: Type.STRING },\\n                  reason: { type: Type.STRING }\\n                },\\n                required: [\'skill\', \'priority\', \'reason\']\\n              }\\n            },\\n            resumeEvidence: {\\n              type: Type.ARRAY,\\n              items: {\\n                type: Type.OBJECT,\\n                properties: {\\n                  claim: { type: Type.STRING },\\n                  evidence: { type: Type.STRING },\\n                  alignment: { type: Type.STRING }\\n                },\\n                required: [\'claim\', \'evidence\', \'alignment\']\\n              }\\n            },\\n            recommendations: {\\n              type: Type.ARRAY,\\n              items: { type: Type.STRING }\\n            },\\n            learningRoadmap: {\\n              type: Type.ARRAY,\\n              items: {\\n                type: Type.OBJECT,\\n                properties: {\\n                  milestone: { type: Type.STRING },\\n                  timeframe: { type: Type.STRING },\\n                  actionItems: { type: Type.ARRAY, items: { type: Type.STRING } },\\n                  resourceSuggestion: { type: Type.STRING }\\n                },\\n                required: [\'milestone\', \'timeframe\', \'actionItems\', \'resourceSuggestion\']\\n              }\\n            },\\n            interviewQuestions: {\\n              type: Type.ARRAY,\\n              items: {\\n                type: Type.OBJECT,\\n                properties: {\\n                  question: { type: Type.STRING },\\n                  topic: { type: Type.STRING },\\n                  expectedFocus: { type: Type.STRING }\\n                },\\n                required: [\'question\', \'topic\', \'expectedFocus\']\\n              }\\n            }\\n          },\\n          required: [\\n            \'matchScore\',\\n            \'matchedSkills\',\\n            \'missingSkills\',\\n            \'resumeEvidence\',\\n            \'recommendations\',\\n            \'learningRoadmap\',\\n            \'interviewQuestions\'\\n          ]\\n        }\\n      }\\n    });\\n    console.log(\'SUCCESS matchScore:\', JSON.parse(res.text).matchScore);\\n  } catch (err) {\\n    console.error(\'error:\', err.message || err);\\n  }\\n});\\n\\\"\",\"Cwd\":\"/\",\"WaitMsBeforeAsync\":12000,\"toolAction\":\"Testing structured resume analysis with gemini-flash-latest\",\"toolSummary\":\"Test full schema with gemini-flash-latest\"}"
