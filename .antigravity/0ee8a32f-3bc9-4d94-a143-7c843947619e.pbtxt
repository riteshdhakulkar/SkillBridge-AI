      create_file {
        instruction: "import React, { useEffect } from \'react\';\nimport { X, CheckCircle2, AlertCircle, FileText, ArrowRight, Sparkles, Building2, Calendar } from \'lucide-react\';\nimport { RecentAnalysis } from \'../data/sampleData\';\n\ninterface AnalysisDetailModalProps {\n  analysis: RecentAnalysis | null;\n  onClose: () => void;\n  onRetest: (roleTitle: string) => void;\n}\n\nexport const AnalysisDetailModal: React.FC<AnalysisDetailModalProps> = ({\n  analysis,\n  onClose,\n  onRetest,\n}) => {\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === \'Escape\') onClose();\n    };\n    if (analysis) {\n      window.addEventListener(\'keydown\', handleKeyDown);\n      document.body.style.overflow = \'hidden\';\n    }\n    return () => {\n      window.removeEventListener(\'keydown\', handleKeyDown);\n      document.body.style.overflow = \'auto\';\n    };\n  }, [analysis, onClose]);\n\n  if (!analysis) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 overflow-y-auto\">\n      {/* Backdrop */}\n      <div\n        className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity\"\n        onClick={onClose}\n        aria-hidden=\"true\"\n      />\n\n      {/* Modal Dialog */}\n      <div className=\"relative w-full max-w-2xl rounded-2xl bg-white shadow-2xl border border-slate-200 transition-all z-10 overflow-hidden my-8\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between border-b border-slate-200 px-6 py-4 bg-slate-50/50\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-white\">\n              <FileText className=\"h-4 w-4\" />\n            </div>\n            <div>\n              <h2 className=\"text-base font-bold text-slate-900\">\n                Analysis Breakdown\n              </h2>\n              <p className=\"text-xs text-slate-500\">\n                {analysis.resumeFileName}\n              </p>\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition-colors cursor-pointer\"\n            aria-label=\"Close details\"\n          >\n            <X className=\"h-5 w-5\" />\n          </button>\n        </div>\n\n        {/* Content */}\n        <div className=\"p-6 space-y-6 max-h-[75vh] overflow-y-auto\">\n          {/* Target Role & Match Score */}\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white p-5\">\n            <div>\n              <div className=\"flex items-center gap-2 text-xs font-semibold text-indigo-600\">\n                <Building2 className=\"h-3.5 w-3.5\" />\n                <span>{analysis.companyTarget}</span>\n                <span className=\"text-slate-300\">\302\267</span>\n                <span className=\"flex items-center gap-1 text-slate-500 font-normal\">\n                  <Calendar className=\"h-3 w-3\" />\n                  {analysis.dateAnalyzed}\n                </span>\n              </div>\n              <h3 className=\"mt-1.5 text-lg font-bold text-slate-900\">\n                {analysis.roleTitle}\n              </h3>\n            </div>\n\n            <div className=\"flex items-center gap-2 self-start sm:self-auto rounded-lg bg-indigo-50 border border-indigo-100 px-4 py-2\">\n              <div className=\"text-right\">\n                <div className=\"text-2xl font-black text-indigo-700 tabular-nums\">\n                  {analysis.matchScore}%\n                </div>\n                <div className=\"text-[10px] font-bold uppercase tracking-wider text-indigo-600\">\n                  Match Rating\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Key Strengths / Matched Skills */}\n          <div>\n            <h4 className=\"text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5 mb-2.5\">\n              <CheckCircle2 className=\"h-4 w-4 text-emerald-600\" />\n              <span>Demonstrated Skills Found ({analysis.matchedSkills.length})</span>\n            </h4>\n            <div className=\"flex flex-wrap gap-2\">\n              {analysis.matchedSkills.map((skill, idx) => (\n                <span\n                  key={idx}\n                  className=\"inline-flex items-center gap-1.5 rounded-md bg-emerald-50 border border-emerald-200/80 px-2.5 py-1 text-xs font-medium text-emerald-800\"\n                >\n                  <CheckCircle2 className=\"h-3 w-3 text-emerald-600\" />\n                  {skill}\n                </span>\n              ))}\n            </div>\n          </div>\n\n          {/* Missing Skills / Growth Opportunities */}\n          <div>\n            <h4 className=\"text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5 mb-2.5\">\n              <AlertCircle className=\"h-4 w-4 text-amber-600\" />\n              <span>Critical Missing Skills to Close ({analysis.missingSkills.length})</span>\n            </h4>\n            <div className=\"space-y-2\">\n              {analysis.missingSkills.map((skill, idx) => (\n                <div\n                  key={idx}\n                  className=\"flex items-center justify-between rounded-lg border border-amber-200/70 bg-amber-50/40 px-3.5 py-2 text-xs\"\n                >\n                  <span className=\"font-semibold text-slate-900\">{skill}</span>\n                  <span className=\"text-[11px] font-medium text-amber-700\">\n                    High recruiter weight\n                  </span>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Top Recommendation */}\n          <div className=\"rounded-xl border border-indigo-100 bg-indigo-50/60 p-4\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-indigo-700\">\n              <Sparkles className=\"h-3.5 w-3.5\" />\n              <span>Recommended Next Action</span>\n            </div>\n            <p className=\"mt-1.5 text-xs text-slate-700 leading-relaxed\">\n              {analysis.topRecommendation}\n            </p>\n          </div>\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"flex items-center justify-between border-t border-slate-100 bg-slate-50/50 px-6 py-3.5\">\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"text-xs font-semibold text-slate-600 hover:text-slate-900 cursor-pointer\"\n          >\n            Close\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => {\n              onClose();\n              onRetest(analysis.roleTitle);\n            }}\n            className=\"inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2 text-xs font-semibold text-white hover:bg-indigo-700 transition-colors cursor-pointer\"\n          >\n            <span>Scan Updated Resume for this Role</span>\n            <ArrowRight className=\"h-3.5 w-3.5\" />\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
