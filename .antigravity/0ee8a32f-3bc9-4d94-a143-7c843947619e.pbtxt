        instruction: "import React, { useEffect } from \'react\';\nimport {\n  X,\n  LayoutDashboard,\n  TrendingUp,\n  Briefcase,\n  CheckCircle2,\n  Clock,\n  ArrowRight,\n  BookOpen,\n  Award,\n} from \'lucide-react\';\n\ninterface DashboardModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onOpenAnalyze: () => void;\n}\n\nexport const DashboardModal: React.FC<DashboardModalProps> = ({\n  isOpen,\n  onClose,\n  onOpenAnalyze,\n}) => {\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === \'Escape\') onClose();\n    };\n    if (isOpen) {\n      window.addEventListener(\'keydown\', handleKeyDown);\n      document.body.style.overflow = \'hidden\';\n    }\n    return () => {\n      window.removeEventListener(\'keydown\', handleKeyDown);\n      document.body.style.overflow = \'auto\';\n    };\n  }, [isOpen, onClose]);\n\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 overflow-y-auto\">\n      {/* Backdrop */}\n      <div\n        className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity\"\n        onClick={onClose}\n        aria-hidden=\"true\"\n      />\n\n      {/* Modal Container */}\n      <div className=\"relative w-full max-w-3xl rounded-2xl bg-white shadow-2xl border border-slate-200 transition-all z-10 overflow-hidden my-8\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between border-b border-slate-200 px-6 py-4 bg-slate-50/50\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-white\">\n              <LayoutDashboard className=\"h-4 w-4\" />\n            </div>\n            <div>\n              <h2 className=\"text-base font-bold text-slate-900\">\n                Student Career Dashboard\n              </h2>\n              <p className=\"text-xs text-slate-500\">\n                Live overview of your skill inventory and tracked positions\n              </p>\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition-colors cursor-pointer\"\n            aria-label=\"Close dashboard\"\n          >\n            <X className=\"h-5 w-5\" />\n          </button>\n        </div>\n\n        {/* Dashboard Content */}\n        <div className=\"p-6 space-y-6 max-h-[80vh] overflow-y-auto\">\n          {/* Quick Metrics Bar */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n            <div className=\"rounded-xl border border-slate-200 bg-white p-4 shadow-2xs\">\n              <div className=\"flex items-center justify-between text-slate-500 text-xs font-semibold\">\n                <span>Average Match Score</span>\n                <TrendingUp className=\"h-4 w-4 text-emerald-600\" />\n              </div>\n              <div className=\"mt-2 text-2xl font-black text-slate-900 tabular-nums\">\n                86%\n              </div>\n              <p className=\"text-[11px] text-emerald-600 font-medium mt-0.5\">\n                +12% after last resume update\n              </p>\n            </div>\n\n            <div className=\"rounded-xl border border-slate-200 bg-white p-4 shadow-2xs\">\n              <div className=\"flex items-center justify-between text-slate-500 text-xs font-semibold\">\n                <span>Tracked Job Roles</span>\n                <Briefcase className=\"h-4 w-4 text-indigo-600\" />\n              </div>\n              <div className=\"mt-2 text-2xl font-black text-slate-900 tabular-nums\">\n                4 Positions\n              </div>\n              <p className=\"text-[11px] text-slate-500 font-medium mt-0.5\">\n                2 new matches found this week\n              </p>\n            </div>\n\n            <div className=\"rounded-xl border border-slate-200 bg-white p-4 shadow-2xs\">\n              <div className=\"flex items-center justify-between text-slate-500 text-xs font-semibold\">\n                <span>Skills Mastered</span>\n                <Award className=\"h-4 w-4 text-amber-600\" />\n              </div>\n              <div className=\"mt-2 text-2xl font-black text-slate-900 tabular-nums\">\n                14 Competencies\n              </div>\n              <p className=\"text-[11px] text-slate-500 font-medium mt-0.5\">\n                3 high-priority gaps remaining\n              </p>\n            </div>\n          </div>\n\n          {/* Skill Mastery Progress */}\n          <div className=\"rounded-xl border border-slate-200 p-5 bg-white\">\n            <h3 className=\"text-sm font-bold text-slate-900 mb-4 flex items-center justify-between\">\n              <span>Target Role Skill Alignment</span>\n              <span className=\"text-xs font-normal text-slate-500\">\n                Role: Associate Full-Stack Developer\n              </span>\n            </h3>\n\n            <div className=\"space-y-3.5\">\n              {[\n                { name: \'TypeScript & JavaScript (ESNext)\', progress: 92, level: \'Interview Ready\' },\n                { name: \'React & Component Architecture\', progress: 88, level: \'Proficient\' },\n                { name: \'Node.js & Express API Design\', progress: 78, level: \'Intermediate\' },\n                { name: \'SQL & Database Optimization\', progress: 65, level: \'In Progress\' },\n                { name: \'Docker & Containerization\', progress: 40, level: \'Next Priority\' },\n              ].map((skill, idx) => (\n                <div key={idx} className=\"space-y-1\">\n                  <div className=\"flex items-center justify-between text-xs\">\n                    <span className=\"font-semibold text-slate-800\">{skill.name}</span>\n                    <span className=\"font-medium text-slate-500\">\n                      {skill.level} \302\267 <span className=\"tabular-nums font-bold text-slate-700\">{skill.progress}%</span>\n                    </span>\n                  </div>\n                  <div className=\"h-2 w-full rounded-full bg-slate-100 overflow-hidden\">\n                    <div\n                      className=\"h-full rounded-full bg-indigo-600 transition-all duration-500\"\n                      style={{ width: `${skill.progress}%` }}\n                    />\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Tracked Job Positions */}\n          <div className=\"rounded-xl border border-slate-200 p-5 bg-white\">\n            <div className=\"flex items-center justify-between mb-4\">\n              <h3 className=\"text-sm font-bold text-slate-900\">\n                Tracked Career Opportunities\n              </h3>\n              <span className=\"text-xs text-slate-500\">Auto-matched with profile</span>\n            </div>\n\n            <div className=\"space-y-2.5\">\n              {[\n                {\n                  title: \'Junior Software Engineer\',\n                  company: \'NextGen Cloud\',\n                  location: \'Remote \302\267 San Francisco\',\n                  match: 88,\n                },\n                {\n                  title: \'Frontend Engineer Intern\',\n                  company: \'Pulse Analytics\',\n                  location: \'Hybrid \302\267 New York\',\n                  match: 94,\n                },\n              ].map((job, idx) => (\n                <div\n                  key={idx}\n                  className=\"flex items-center justify-between p-3 rounded-lg border border-slate-100 bg-slate-50/70\"\n                >\n                  <div>\n                    <h4 className=\"text-xs font-bold text-slate-900\">{job.title}</h4>\n                    <p className=\"text-[11px] text-slate-500\">\n                      {job.company} \302\267 {job.location}\n                    </p>\n                  </div>\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"text-right\">\n                      <span className=\"text-xs font-bold text-indigo-600 tabular-nums\">\n                        {job.match}%\n                      </span>\n                      <p className=\"text-[10px] text-slate-400\">Match</p>\n                    </div>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Action Footer inside Modal */}\n          <div className=\"flex items-center justify-between pt-4 border-t border-slate-100\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"text-xs font-semibold text-slate-500 hover:text-slate-800 cursor-pointer\"\n            >\n              Back to Landing Page\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => {\n                onClose();\n                onOpenAnalyze();\n              }}\n              className=\"inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2 text-xs font-semibold text-white hover:bg-indigo-700 transition-colors cursor-pointer\"\n            >\n              <span>Scan New Resume</span>\n              <ArrowRight className=\"h-3.5 w-3.5\" />\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/DashboardModal.tsx"
        }
        overwrite: true
      }
    }
